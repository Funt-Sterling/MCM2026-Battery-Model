\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The electro-thermal feedback loop. Current generates heat, heat changes resistance, and resistance affects the power dissipation---a fully coupled nonlinear system.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:thermal_feedback}{{5}{6}{The electro-thermal feedback loop. Current generates heat, heat changes resistance, and resistance affects the power dissipation---a fully coupled nonlinear system}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Thermal Runaway Phase Plane: Heat generation ($Q_{gen} = I^2R$) vs.\ heat dissipation ($Q_{cool} = hA(T-T_{amb})$). Where curves intersect defines the stable operating point. For gaming loads (red), the equilibrium occurs at 44$^\circ $C, dangerously close to the throttle threshold. The shaded region shows runaway risk where $Q_{gen} > Q_{cool}$. This phase plane visualizes the ``invisible'' electro-thermal feedback loop.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:thermal_runaway}{{6}{6}{Thermal Runaway Phase Plane: Heat generation ($Q_{gen} = I^2R$) vs.\ heat dissipation ($Q_{cool} = hA(T-T_{amb})$). Where curves intersect defines the stable operating point. For gaming loads (red), the equilibrium occurs at 44$^\circ $C, dangerously close to the throttle threshold. The shaded region shows runaway risk where $Q_{gen} > Q_{cool}$. This phase plane visualizes the ``invisible'' electro-thermal feedback loop}{figure.caption.8}{}}
